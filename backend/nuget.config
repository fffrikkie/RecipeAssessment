<?xml version="1.0" encoding="utf-8"?>
<!--
  Solution-local NuGet configuration.
  Ensures the public nuget.org feed is available and enabled for this solution,
  independent of any machine-wide configuration that may have it disabled.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
